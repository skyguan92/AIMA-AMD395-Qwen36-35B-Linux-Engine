[Unit]
Description=AIMA AMD395 Qwen3.6 resident inference engine
After=local-fs.target

[Service]
Type=simple
User=aima
Group=aima
SupplementaryGroups=render video
WorkingDirectory=/var/lib/aima-qwen36
EnvironmentFile=/etc/aima-qwen36/engine.env
ExecStart=/opt/aima-engine/bin/aima-engine serve --model-dir ${AIMA_MODEL_DIR} --context-tokens ${AIMA_CONTEXT_TOKENS} --host ${AIMA_HOST} --port ${AIMA_PORT} --report /var/lib/aima-qwen36/native-weight-load.json
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aima-qwen36

[Install]
WantedBy=multi-user.target
